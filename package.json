{
  "name": "english-word-splitter",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "echo 'Run: cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 4000'",
    "build": "npm run build -w shared && npm run build -w frontend",
    "test": "npm run test -w shared && npm run test -w frontend",
    "test:frontend": "npm run test -w frontend"
  }
}
