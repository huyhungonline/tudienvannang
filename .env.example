# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=english_word_splitter
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/english_word_splitter

# reCAPTCHA
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key-here
RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here

# Authentication
JWT_SECRET=your-jwt-secret-here

# Email sender display name
SMTP_HOST=pro203.emailserver.vn
SMTP_PORT=465
SMTP_USER=admin@jaenglish.com
SMTP_PASSWORD=your-mailbox-password-here
FROM_EMAIL=admin@jaenglish.com
FROM_NAME=Táo Giáo Dục
APP_URL=https://jaenglish.com

# Audio
AUDIO_FILES_PATH=/audio

# AWS S3 daily database backup (used by backup-db-s3.sh on the VPS)
AWS_ACCESS_KEY_ID=your-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
AWS_REGION=ap-southeast-1
S3_BACKUP_BUCKET=your-backup-bucket-name
